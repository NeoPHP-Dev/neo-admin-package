{# @NeoAdmin/pages/login.html.twig #}
<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <title>Login — {{ adminConfig().title ?? 'Administration' }}</title>
        <link rel="stylesheet" href="/packages-assets/NeoAdmin/css/base.css">
        <link rel="stylesheet" href="/packages-assets/NeoAdmin/css/content.css">
    </head>
    <body class="admin-login-body">
        <form method="post" action="{{ path('admin.auth.login.submit') }}" class="admin-login-form">
            <h1>{{ adminConfig().title ?? 'Administration' }}</h1>

            {% if error is defined %}
                <p class="admin-login-error">{{ error }}</p>
            {% endif %}

            <input type="email" name="email" placeholder="Email" required>
            <input type="password" name="password" placeholder="Password" required>
            <button type="submit">Log in</button>
        </form>
    </body>
</html>