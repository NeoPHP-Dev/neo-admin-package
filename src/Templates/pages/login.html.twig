{# @NeoAdmin/pages/login.html.twig #}
<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <title>Login — {{ adminConfig().title ?? 'Administration' }}</title>
        <link rel="stylesheet" href="/packages-assets/NeoAdmin/css/base.css">
        <link rel="stylesheet" href="/packages-assets/NeoAdmin/css/content.css">
    </head>
    <body class="admin-login-body">
        <div class="admin-login-form">
            <h1>{{ adminConfig().title ?? 'Administration' }}</h1>

            {% if error is defined %}
                <p class="admin-login-error">{{ error }}</p>
            {% endif %}

            {{ form_start(form, path('admin.auth.login.submit'), 'POST', {'class': 'admin-login-fields'}) }}
                {{ form_row(form, 'email') }}
                {{ form_row(form, 'password') }}
                <button type="submit">Log in</button>
            {{ form_end() }}
        </div>
    </body>
</html>