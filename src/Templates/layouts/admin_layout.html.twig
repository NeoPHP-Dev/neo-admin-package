{# @NeoAdmin/layouts/admin_layout.html.twig #}
{% import '@NeoAdmin/partials/macros/Icon.macro.html.twig' as Icon %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{ adminConfig().title ?? 'Administration' }}</title>
    <link rel="stylesheet" href="/packages-assets/NeoAdmin/css/admin.css">
</head>
<body class="admin-body">
{% include '@NeoAdmin/partials/sidebar.html.twig' %}

<main class="admin-main">
    <header class="admin-topbar">
        <span>{{ adminConfig().title ?? 'Administration' }}</span>
        <a href="{{ path('admin.auth.logout') }}" class="admin-logout-link">
            {{ Icon.render('log-out', 16) }}
            <span>Logout</span>
        </a>
    </header>

    <section class="admin-content">
        {% block content %}{% endblock %}
    </section>
</main>
</body>
</html>