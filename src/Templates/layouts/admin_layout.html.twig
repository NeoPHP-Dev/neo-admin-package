{# @NeoAdmin/layouts/admin_layout.html.twig #}
<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}{{ adminConfig().title ?? 'Administration' }}{% if adminConfig().description %} — {{ adminConfig().description }}{% endif %}{% endblock %}</title>

        <link rel="stylesheet" href="/packages-assets/NeoAdmin/css/base.css">
        <link rel="stylesheet" href="/packages-assets/NeoAdmin/css/sidebar.css">
        <link rel="stylesheet" href="/packages-assets/NeoAdmin/css/header.css">
        <link rel="stylesheet" href="/packages-assets/NeoAdmin/css/content.css">

        {% block stylesheets %}{% endblock %}
    </head>
    <body class="admin-body">
        {% include '@NeoAdmin/partials/sidebar.html.twig' %}

        <main class="admin-main">
            {% include '@NeoAdmin/partials/header.html.twig' %}

            <section class="admin-content">
                {% block content %}{% endblock %}
            </section>
        </main>

        <script src="https://cdn.jsdelivr.net/npm/lucide@1.29.0/dist/umd/lucide.min.js"></script>
        <script src="/packages-assets/NeoAdmin/js/admin.js"></script>
        <script src="/packages-assets/NeoAdmin/js/sidebar.js"></script>
        {% block javascripts %}{% endblock %}
    </body>
</html>