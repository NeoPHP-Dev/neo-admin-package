{# @NeoAdmin/layouts/admin_layout.html.twig #}

{% import '@NeoAdmin/components/macros/Icon.macro.html.twig' as Icon %}

<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <title>
            {% block title %}
                {{ adminConfig().title ?? 'Administration' }}
                {% if adminConfig().description %} — {{ adminConfig().description }}{% endif %}
            {% endblock %}
        </title>

        <link rel="stylesheet" href="/packages-assets/NeoAdmin/css/base.css">
        <link rel="stylesheet" href="/packages-assets/NeoAdmin/css/sidebar.css">
        <link rel="stylesheet" href="/packages-assets/NeoAdmin/css/header.css">
        <link rel="stylesheet" href="/packages-assets/NeoAdmin/css/content.css">

        {% block stylesheets %}{% endblock %}
    </head>
    <body class="admin-body">
        {% include '@NeoAdmin/partials/sidebar.html.twig' %}

        <main class="admin-main">
            {% include '@NeoAdmin/partials/header.html.twig' %}

            <section class="admin-content">
                {% block content %}{% endblock %}
            </section>
        </main>

        {% block javascripts %}{% endblock %}
    </body>
</html>