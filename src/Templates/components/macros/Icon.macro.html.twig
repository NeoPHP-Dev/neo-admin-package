{#
    Lucide icons, loaded via CDN (lucide.min.js) and rendered client-side.
    The <i data-lucide="..."> placeholder is replaced by lucide.createIcons()
    at page load — see admin_layout.html.twig for the script tag.

    Usage:
    {% import '@NeoAdmin/partials/macros/Icon.macro.html.twig' as Icon %}
    {{ Icon.render('layout-dashboard') }}
#}
{% macro render(name, size = 18) %}
    <i data-lucide="{{ name }}" style="width: {{ size }}px; height: {{ size }}px;"></i>
{% endmacro %}